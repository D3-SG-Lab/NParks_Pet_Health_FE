# Only EXPO_PUBLIC_ variables reach the app bundle. Never put secrets here.
# Copy to .env and fill in. Values are intentionally empty in this template.

# Backend base URL (NestJS API)
EXPO_PUBLIC_API_URL=

# Auth mode: "oidc" (default) or "mock". Mock only works in development builds (__DEV__).
EXPO_PUBLIC_AUTH_MODE=

# Development auth bypass: "officer" or "contractor" starts every launch signed in as that role
# (mock tokens, no sign-in, unlock or idle sign-out). Picking a role on /sign-in switches to it (kept across
# web reloads in that tab). Leave empty to turn it off. Development builds only.
EXPO_PUBLIC_AUTH_BYPASS=

# Session idle timeout in minutes (temporary default 15 if empty; final value undecided)
EXPO_PUBLIC_SESSION_IDLE_MINUTES=

# Token claim that carries the user role (officer | contractor). Defaults to "role".
EXPO_PUBLIC_ROLE_CLAIM=

# AVS / NParks officer identity provider
EXPO_PUBLIC_OFFICER_OIDC_ISSUER=
EXPO_PUBLIC_OFFICER_OIDC_CLIENT_ID=
# Must be one of the schemes registered in app.json "scheme"
EXPO_PUBLIC_OFFICER_OIDC_REDIRECT_SCHEME=

# Contractor identity provider
EXPO_PUBLIC_CONTRACTOR_OIDC_ISSUER=
EXPO_PUBLIC_CONTRACTOR_OIDC_CLIENT_ID=
# Must be one of the schemes registered in app.json "scheme"
EXPO_PUBLIC_CONTRACTOR_OIDC_REDIRECT_SCHEME=
